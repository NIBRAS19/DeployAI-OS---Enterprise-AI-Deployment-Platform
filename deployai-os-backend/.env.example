# Copy this file to .env and adjust as needed.

# Defaults to a local SQLite file if unset — good for a zero-setup demo.
# For production-like behavior (real pgvector similarity search at the SQL
# level), point this at Postgres with the pgvector extension installed —
# see docker-compose.yml, which provisions exactly that.
DATABASE_URL=sqlite:///./deployai.db

# Signing key for access tokens. Generate a real one for anything beyond
# local dev, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional. When unset, the assistant and retrieval endpoints fall back to
# deterministic mock responses (the same ones the frontend's preview widgets
# use) so the API is fully runnable with zero external credentials. Set this
# to enable real, cited answers from Claude grounded in retrieved chunks.
ANTHROPIC_API_KEY=

# Comma-separated list of origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000
